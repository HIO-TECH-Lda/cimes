{
  "name": "cimes",
  "version": "0.1.0",
  "private": true,
  "description": "CIMES — Cornelder Internship Management, AI Matching & Evaluation System",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch worker/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run test:e2e:smoke",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/seed.ts",
    "ai:eval": "tsx tests/ai-evals/run.ts",
    "keys:rewrap": "tsx scripts/keys-rewrap.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "altcha": "^3.5.0",
    "better-auth": "^1.7.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.68.0",
    "mssql": "12.7.13",
    "next": "16.4.5",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testcontainers/mssqlserver": "12.2.1",
    "dotenv": "^18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
