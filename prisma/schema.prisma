model Evaluation {
  id                       String             @id @default(cuid()) @db.VarChar(30)
  internshipId             String             @db.VarChar(30)
  internship               Internship         @relation(fields: [internshipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
