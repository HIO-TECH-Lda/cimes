model DiaryAttachment {
  id           String     @id @default(cuid()) @db.VarChar(30)
  diaryEntryId String     @db.VarChar(30)
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
